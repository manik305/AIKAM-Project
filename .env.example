# Environment Configuration Template for UrjaMitra AI
# NEVER commit production secrets or real API keys to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Authentication
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=urjamitra_user
POSTGRES_PASSWORD=urjamitra_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urjamitra_db
DATABASE_URL=postgresql+asyncpg://urjamitra_user:urjamitra_secure_password@localhost:5432/urjamitra_db

# Cache & Message Broker (Redis Cluster)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO for Meter Photos & Bill PDFs)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meter-evidence-vault
S3_REGION=ap-south-1

# Jev Model & LLM Provider API Keys
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=your_jev_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Utility Integration (Mock / Real DISCOM SAP IS-U BAPI)
SAP_ISU_GATEWAY_URL=https://sandbox.tgspdcl.gov.in/sap/bc/bapi
SAP_CLIENT_ID=mock_client_id
SAP_CLIENT_SECRET=mock_client_secret
